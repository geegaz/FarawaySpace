[gd_resource type="Shader" format=2]

[resource]
code = "// NOTE: Shader automatically converted from Godot Engine 3.5.3.stable's SpatialMateria

shader_type spatial;
render_mode async_visible,blend_mix,depth_draw_never,cull_back;
uniform vec4 color : hint_color;
uniform sampler2D light_map : hint_albedo;
uniform sampler2D alpha_map : hint_white;
uniform float distance_fade_min;
uniform float distance_fade_max;
uniform int particles_anim_h_frames;
uniform int particles_anim_v_frames;
uniform bool particles_anim_loop;
uniform vec3 uv1_scale;
uniform vec3 uv1_offset;

float remap(float value, float in_low, float in_high, float out_low, float out_high)
{
	return out_low + (value - in_low) * (out_high - out_low) / (in_high - in_low);
}

void vertex() {
	// Base UV offsetting
	UV=UV*uv1_scale.xy+uv1_offset.xy;
	
	// Billboarding
	mat4 mat_world = mat4(normalize(CAMERA_MATRIX[0])*length(WORLD_MATRIX[0]),normalize(CAMERA_MATRIX[1])*length(WORLD_MATRIX[0]),normalize(CAMERA_MATRIX[2])*length(WORLD_MATRIX[2]),WORLD_MATRIX[3]);
	mat_world = mat_world * mat4( vec4(cos(INSTANCE_CUSTOM.x),-sin(INSTANCE_CUSTOM.x), 0.0, 0.0), vec4(sin(INSTANCE_CUSTOM.x), cos(INSTANCE_CUSTOM.x), 0.0, 0.0),vec4(0.0, 0.0, 1.0, 0.0),vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_MATRIX = INV_CAMERA_MATRIX * mat_world;
	
	// Particle animation
	float h_frames = float(particles_anim_h_frames);
	float v_frames = float(particles_anim_v_frames);
	float particle_total_frames = float(particles_anim_h_frames * particles_anim_v_frames);
	float particle_frame = floor(INSTANCE_CUSTOM.z * float(particle_total_frames));
	if (!particles_anim_loop) {
		particle_frame = clamp(particle_frame, 0.0, particle_total_frames - 1.0);
	} else {
		particle_frame = mod(particle_frame, particle_total_frames);
	}
	UV /= vec2(h_frames, v_frames);
	UV += vec2(mod(particle_frame, h_frames) / h_frames, floor((particle_frame + 0.5) / h_frames) / v_frames);
}

void fragment() {
	ALBEDO = COLOR.rgb;
	
	vec4 alpha_map_tex = texture(alpha_map, UV);
	ALPHA = alpha_map_tex.r * COLOR.a;
	ALPHA *= clamp(smoothstep(distance_fade_min,distance_fade_max,-VERTEX.z),0.0,1.0);
}

void light() 
{
	// Smoke: custom handling of the texture
	// From https://realtimevfx.com/t/smoke-lighting-and-texture-re-usability-in-skull-bones/5339
	
	vec4 rawLightMap = texture(light_map,UV);
	float frontMap = 0.25f * (rawLightMap.x+rawLightMap.y+rawLightMap.z+rawLightMap.w);
	frontMap = pow(frontMap, 0.625);
	float backMap =  1.0f - frontMap;
	backMap = clamp(0.25*(1.0-NORMAL.x) + 0.5*(backMap*backMap*backMap*backMap), 0.0, 1.0);
	
	float hMap = (LIGHT.x > 0.0f) ? (rawLightMap.x) : (rawLightMap.y);	// Picks the correct horizontal side.
	float vMap = (LIGHT.y > 0.0f) ? (rawLightMap.w) : (rawLightMap.z);	// Picks the correct vertical side.
	float dMap = (LIGHT.z > 0.0f) ? (frontMap) : (backMap);				// Picks the correct Front/back pseudo Map
	float lightMap = hMap*LIGHT.x*LIGHT.x + vMap*LIGHT.y*LIGHT.y + dMap*LIGHT.z*LIGHT.z; // Pythagoras!
	
	DIFFUSE_LIGHT += remap(clamp(lightMap, 0.0, 1.0), 0.0, 1.0, 0.5, 1.0) * ATTENUATION * ALBEDO;
}
"
