[application]

config/name="Faraway Spaces V1"
config/description="No Description"
run/main_scene="res://Scenes/Main.tscn"
config/icon="res://icon.png"

[autoload]

UIManager="*res://Scripts/Autoloads/UIManager.gd"
PlayerManager="*res://Scripts/Autoloads/PlayerManager.gd"
SceneManager="*res://Scripts/Autoloads/SceneManager.gd"
Screenshake="*res://Scripts/Autoloads/Screenshake.gd"
DebugDraw="*res://Scripts/Autoloads/DebugDraw.gd"

[editor_plugins]

enabled=PoolStringArray( "res://addons/godot-polyliner/plugin.cfg", "res://addons/zylann.hterrain/plugin.cfg" )

[global]

scaling=false

[godots]

version_hint=""

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 2,
"compress/normal_map": 2,
"detect_3d": true,
"flags/anisotropic": false,
"flags/filter": true,
"flags/mipmaps": true,
"flags/repeat": 1,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

