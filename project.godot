"language": "GDScript",
"path": "res://addons/cubemap_generator/cubemap_generator.gd"
}, {
"base": "Trigger",
"class": "GravityTrigger",
"language": "GDScript",
"path": "res://Scripts/Triggers/GravityTrigger.gd"
}, {
"base": "ResourceFormatLoader",
"class": "HTerrainDataLoader",
"language": "GDScript",
"path": "res://addons/zylann.hterrain/hterrain_resource_loader.gd"
}, {
"base": "ResourceFormatSaver",
"class": "HTerrainDataSaver",
"language": "GDScript",
"path": "res://addons/zylann.hterrain/hterrain_resource_saver.gd"
}, {
"base": "Reference",
"class": "ImmediateSurface",
"language": "GDScript",
"path": "res://addons/godot-polyliner/LineGen3D/ImmediateSurface.gd"
}, {
"base": "Resource",
"class": "LevelData",
"language": "GDScript",
"path": "res://Scripts/Levels/LevelData.gd"
}, {
"base": "Trigger",
"class": "LevelTrigger",
"language": "GDScript",
"path": "res://Scripts/Triggers/LevelTrigger.gd"
}, {
"base": "Resource",
"class": "LineGen3D",
"language": "GDScript",
"path": "res://addons/godot-polyliner/LineGen3D/LineGen3D.gd"
}, {
"base": "Spatial",
"class": "PhysInterp",
"language": "GDScript",
"path": "res://addons/godot-recipes/phys_interp.gd"
}, {
"base": "RigidBody",
"class": "Rope3D",
"language": "GDScript",
"path": "res://addons/godot-polyliner/demos/ropetesting/Rope3D.gd"
}, {
"base": "KinematicBody",
"class": "Ship",
"language": "GDScript",
"path": "res://Scripts/Ship/Ship.gd"
}, {
"base": "Node",
"class": "ShipEffects",
"language": "GDScript",
