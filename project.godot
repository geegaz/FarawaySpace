}, {
"base": "Spatial",
"class": "ShipSpawner",
"language": "GDScript",
"path": "res://Scripts/Ship/ShipSpawner.gd"
}, {
"base": "Control",
"class": "Transition",
"language": "GDScript",
"path": "res://Scripts/UI/Transition.gd"
}, {
"base": "Area",
"class": "Trigger",
"language": "GDScript",
"path": "res://Scripts/Triggers/Trigger.gd"
}, {
"base": "Spatial",
"class": "Tutorial",
"language": "GDScript",
"path": "res://Scripts/Tutorial.gd"
} ]
