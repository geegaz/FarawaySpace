; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="De Passage"
run/main_scene="res://Scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Geegaz/De Passage"
config/features=PackedStringArray("4.5")
config/icon="res://icon.png"

[autoload]

PlayerSave="*res://Scripts/Autoloads/PlayerSave.gd"
PlayerSettings="*res://Scripts/Autoloads/PlayerSettings.gd"
PlayerManager="*res://Scripts/Autoloads/PlayerManager.gd"
LevelManager="*res://Scripts/Autoloads/LevelManager.gd"
UIManager="*res://Scenes/Autoloads/UIManager.tscn"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/lines_and_trails_3d/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[filesystem]

import/fbx2gltf/enabled=false
import/blender/enabled=false

[godots]

version_hint="4.5"

[gui]

theme/custom="res://default_theme.tres"

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 2,
"compress/normal_map": 2,
"detect_3d": true,
"flags/anisotropic": false,
"flags/filter": true,
"flags/mipmaps": true,
"flags/repeat": 1,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

